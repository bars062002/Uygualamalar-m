            btn.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 text-white flex-shrink-0 shadow-md';

            // Filter items
            const items = document.querySelectorAll('.task-item');
            let visibleCount = 0;
            items.forEach(item => {
                const cat = item.getAttribute('data-category');
                const pri = item.getAttribute('data-priority');
                if (category === 'all' || cat === category || (category === 'priority' && pri === 'high')) {
                    item.style.display = 'flex';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            const emptyState = document.getElementById('empty-state');
            if (emptyState) {
                emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
            }
        }

        function toggleTask(checkbox) {
            const titleEl = checkbox.nextElementSibling.querySelector('h4');
            if (checkbox.checked) {
